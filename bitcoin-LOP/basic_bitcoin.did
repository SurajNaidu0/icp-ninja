type satoshi = nat64;

type millisatoshi_per_vbyte = nat64;

type bitcoin_address = text;

type network = variant {
  regtest;
  testnet;
  mainnet;
};

type outpoint = record {
  txid : blob;
  vout : nat32;
};

type utxo = record {
  outpoint : outpoint;
  value : satoshi;
  height : nat32;
};

type get_utxos_response = record {
  utxos : vec utxo;
  tip_block_hash : block_hash;
  tip_height : nat32;
  next_page : opt blob;
};

type block_hash = blob;

type order_detail = record {
  initiator_pubkey : text;
  time_lock : nat64;
  secret_hash : text;
  order_address : opt text;
};

type order_withdraw_info = record {
  order_address : text;
  order_balance : nat64;
  htlc_address : text;
  order_details : order_detail;
};

// New order system types
type htlc_type = variant {
  P2TR;
  P2WSH;
  ICPEscrow;
};

type maker_key = record {
  source_address : text;
  source_pubkey : opt text;
  destination_address : text;
};

type taker_key = record {
  source_address : text;
  destination_address : text;
  destination_pubkey : opt text;
};

type auction_details = record {
  initial_rate_bump : nat64;
  points : vec nat64;
  duration : nat64;
  start_time : nat64;
};

type partial_fill = record {
  taker_key : taker_key;
  filled_amount : nat64;
  remaining_amount : nat64;
  fill_timestamp : nat64;
};

type order_fill_status = record {
  total_filled : nat64;
  remaining_amount : nat64;
  partial_fills : vec partial_fill;
  is_fully_filled : bool;
};

type secret_management = record {
  merkle_root : text;
  total_secrets : nat64;
  used_secrets : vec nat64;
  secret_hashes : vec text;
};


type order_detail_new = record {
  salt : nat64;
  maker_key : maker_key;
  taker_key : opt taker_key;
  htlc_type : htlc_type;
  dst_chain_id : nat64;
  making_amount : nat64;
  taking_amount : nat64;
  taking_asset : text;
  hashlock : text;
  timelock : nat64;
  auction : auction_details;
  allow_partial_fills : bool;
  order_contract_bitcoin_path : nat32;
  order_address : opt text;
  fill_status : opt order_fill_status;
  secret_management : opt secret_management;
  processing : bool;
};

service : (network) -> {
  // Basic Bitcoin functionality
  "get_balance" : (address : bitcoin_address) -> (satoshi);
  "get_utxos" : (bitcoin_address) -> (get_utxos_response);
  "get_current_fee_percentiles" : () -> (vec millisatoshi_per_vbyte);

  // Order Protocol functionality
  "create_order" : (initiator_pubkey: text, time_lock: nat64, secret_hash: text) -> (nat64);
  "get_order" : (order_no: nat64) -> (opt order_detail) query;
  "get_all_orders" : () -> (vec record { nat64; order_detail }) query;
  "get_next_order_no" : () -> (nat64) query;
  "get_order_address" : (order_no: nat64) -> (variant { Ok: text; Err: text });
  "preview_order_withdrawal" : (order_no: nat64, responder_pubkey: text) -> (variant { Ok: order_withdraw_info; Err: text });
  "execute_order_withdraw_to_htlc" : (order_no: nat64, responder_pubkey: text, amount_in_satoshi: nat64) -> (variant { Ok: text; Err: text });
  "recover_order" : (order_no: nat64, recovery_address: text, amount_in_satoshi: nat64) -> (variant { Ok: text; Err: text });

  // New Order Protocol functionality
  "create_order_new" : (salt: nat64, maker_key: maker_key, htlc_type: htlc_type, dst_chain_id: nat64, making_amount: nat64, taking_amount: nat64, taking_asset: text, hashlock: text, timelock: nat64, auction: auction_details, allow_partial_fills: bool) -> (variant { Ok: text; Err: text });
  "get_order_new" : (order_hash: text) -> (opt order_detail_new) query;
  "get_all_orders_new" : () -> (vec record { text; order_detail_new }) query;
  "get_orders_count_new" : () -> (nat32) query;
  "get_next_bitcoin_path_new" : () -> (nat32) query;
  "get_order_address_new" : (order_hash: text) -> (variant { Ok: text; Err: text });

  // Auction functionality
  "calculate_auction_price" : (order_hash: text) -> (variant { Ok: nat64; Err: text }) query;
  "validate_auction_bid" : (order_hash: text, bid_price: nat64) -> (variant { Ok: bool; Err: text }) query;
  "get_auction_status" : (order_hash: text) -> (variant { Ok: text; Err: text }) query;
  "execute_auction_redemption" : (order_hash: text, taker_key: taker_key, amount_in_satoshi: nat64, bid_price: nat64) -> (variant { Ok: text; Err: text });

  // Partial fill functionality
  "get_order_fill_status" : (order_hash: text) -> (variant { Ok: opt order_fill_status; Err: text }) query;
  "is_order_fully_filled" : (order_hash: text) -> (variant { Ok: bool; Err: text }) query;
  "get_remaining_amount" : (order_hash: text) -> (variant { Ok: nat64; Err: text }) query;

  // Secret management (off-chain generation)
  "set_secret_hashes_for_partial_fills" : (order_hash: text, secret_hashes: vec text) -> (variant { Ok: secret_management; Err: text });
  "generate_secrets_offchain_helper" : () -> (variant { Ok: vec text; Err: text }) query;
  "generate_p2tr_htlc_address_test" : (payment_hash: text, initiator_pubkey: text, responder_pubkey: text, timelock: nat64) -> (variant { Ok: text; Err: text }) query;


  // Testing and validation
  "test_secret_selection_logic" : (order_hash: text, test_fill_amounts: vec nat64) -> (variant { Ok: vec record { nat64; nat64; float64; text }; Err: text }) query;
  "test_merkle_root_calculation" : () -> (variant { Ok: vec record { text; text; text }; Err: text }) query;
};
